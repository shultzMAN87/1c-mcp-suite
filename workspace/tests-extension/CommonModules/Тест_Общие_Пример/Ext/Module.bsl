// Пример тестового модуля YAxUnit для расширения «КотировкиТесты».
//
// Этот модуль создан как стартовая заглушка-проверка пайплайна:
// один тест, который заведомо проходит. Когда агент в OpenCode будет
// добавлять новые тестовые модули, ориентируйся на эту структуру.
//
// Структура модуля:
//   ИсполняемыеСценарии() — обязательный entrypoint. Регистрирует
//                           тесты в движке YAxUnit.
//   <ИмяТеста>()          — собственно тестовая процедура.
//
// Соглашение об именах модулей внутри расширения:
//   Тест_<Подсистема>_<ИмяОбъекта>
//   - Тест_Аукционы_*    — тесты для подсистемы Аукционы
//   - Тест_УБД_*         — тесты для подсистемы УБД
//   - Тест_Котировки_*   — тесты для основной подсистемы Котировки
//   - Тест_Эдо_*         — тесты для подсистемы ЭДО
//   - Тест_Общие_*       — тесты, не привязанные к подсистеме
//                          (общие модули типа ОбщегоНазначения)

#Область ПрограммныйИнтерфейс

// Регистрация тестов в движке YAxUnit. Имя метода фиксированное —
// движок ищет по нему точку входа.
Процедура ИсполняемыеСценарии() Экспорт

	ЮТТесты
		.ДобавитьТест("ПайплайнЖив_ДваПлюсДваРавно4");

КонецПроцедуры

// Тривиальная проверка, что пайплайн доходит от LoadConfigFromFiles
// до фактического исполнения BSL-кода тестов в 1С:Предприятии.
// Когда этот тест становится зелёным — стек собран и работает.
// Использует то же сравнение .Равно(), что и проверенный demo-тест
// в yaxunit-stack/sandbox/demo-tests — берём заведомо рабочий API.
Процедура ПайплайнЖив_ДваПлюсДваРавно4() Экспорт

	Результат = 2 + 2;

	ЮТест.ОжидаетЧто(Результат, "2 + 2 = 4")
		.Равно(4);

КонецПроцедуры

#КонецОбласти
