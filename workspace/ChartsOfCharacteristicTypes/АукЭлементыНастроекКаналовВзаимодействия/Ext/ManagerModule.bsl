Функция ЭлементНастроекПоТехническомуНаименованию(пТехническоеНаименование) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	АукЭлементыНастроекКаналовВзаимодействия.Ссылка КАК Ссылка
	|ИЗ
	|	ПланВидовХарактеристик.АукЭлементыНастроекКаналовВзаимодействия КАК АукЭлементыНастроекКаналовВзаимодействия
	|ГДЕ
	|	АукЭлементыНастроекКаналовВзаимодействия.ТехническоеНаименование = &ТехническоеНаименование";
	
	Запрос.УстановитьПараметр("ТехническоеНаименование", пТехническоеНаименование);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		
		Возврат Неопределено;
		
	КонецЕсли;	
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Выборка.Следующий();
	
	Возврат Выборка.Ссылка;
	
КонецФункции	

