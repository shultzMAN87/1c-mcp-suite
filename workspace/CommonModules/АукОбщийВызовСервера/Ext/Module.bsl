Процедура СохранитьДанныеПромежуточногоЛидераЭтапа(пСткДанные) Экспорт
	Если Не пСткДанные.Свойство("ДатаЗаписи") Тогда
		пСткДанные.Вставить("ДатаЗаписи", ОбщегоНазначенияВызовСервера.ТекущаяДатаСервер_());
	КонецЕсли;
	
	РегистрыСведений.АукИтогиЗавершенияЭтапов.ДобавитьЗапись(пСткДанные);
КонецПроцедуры

Процедура СохранитьДанныеОкончательныхИтогов(пСткДанные) Экспорт
	Если Не пСткДанные.Свойство("ДатаЗаписи") Тогда
		пСткДанные.Вставить("ДатаЗаписи", ОбщегоНазначенияВызовСервера.ТекущаяДатаСервер_());
	КонецЕсли;
	
	Если Не пСткДанные.Свойство("Автор") Тогда
		пСткДанные.Вставить("Автор", ПараметрыСеанса.глТекПользователь);
	КонецЕсли;
	
	НачатьТранзакцию();
	Попытка
		// 1. Зафиксировать данные шапок
		РегистрыСведений.АукДанныеШапокПодведенияИтогов.ДобавитьЗапись(пСткДанные);
		
		// 2. Зафиксировать данные таблиц итогов
		РегистрыСведений.АукДанныеТаблицПодведенияИтогов.ЗафиксироватьИтогиАукциона(пСткДанные);
		
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		
		стрОшибка = ОписаниеОшибки();
		
		ВызватьИсключение стрОшибка;		
	КонецПопытки;	
КонецПроцедуры

Функция СохранитьДанныеПобедителейЭтапов(пСткДанные) Экспорт	
	пСткДанные.Вставить("Автор",	ПараметрыСеанса.глТекПользователь);	
	пСткДанные.Вставить("ТекДата",	ОбщегоНазначенияВызовСервера.ТекущаяДатаСервер_());
	
	масЗаписи1 = РегистрыСведений.АукРасчетИтоговПараметры.ПодготовитьДанныеДляЗаписи(пСткДанные);
	масЗаписи2 = РегистрыСведений.АукРасчетИтоговПеременные.ПодготовитьДанныеДляЗаписи(пСткДанные); 
	масЗаписи3 = РегистрыСведений.АукРасчетИтоговРезультаты.ПодготовитьДанныеДляЗаписи(пСткДанные);
	
	НачатьТранзакцию();
	
	Попытка
		РегистрыСведений.АукРасчетИтоговПараметры.ДобавитьЗаписи(масЗаписи1);
		РегистрыСведений.АукРасчетИтоговПеременные.ДобавитьЗаписи(масЗаписи2);	
		РегистрыСведений.АукРасчетИтоговРезультаты.ДобавитьЗаписи(масЗаписи3);
		
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		
		стрОшибка = ОписаниеОшибки();
		
		ВызватьИсключение стрОшибка;
	КонецПопытки;
КонецФункции
	
#КонецОбласти

