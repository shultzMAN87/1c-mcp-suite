Функция ТекстДоИПослеВШаблонеРезультатаРасчета(пСтрокаШаблона) Экспорт
	сткРез = Новый Структура("ТекстДо, ТекстПосле", "", "");
	
	масШаблонРезультата = СтрокаНайтиВсеПоРегулярномуВыражениюТолькоЗначения(пСтрокаШаблона, АукОбщийКлиентСервер.Шаблон_ПредставлениеПромежуточногоИтогаCКлючевымСловом());
	
	Если масШаблонРезультата.Количество() = 2 Тогда 	
		Если масШаблонРезультата[0] = АукОбщийКлиентСервер.ОперандПредставленияПромежуточногоИтога() Тогда
			сткРез.ТекстПосле = масШаблонРезультата[1];	
		Иначе
			сткРез.ТекстДо = масШаблонРезультата[0];	
		КонецЕсли;
	ИначеЕсли масШаблонРезультата.Количество() = 3 Тогда
		сткРез.ТекстДо = масШаблонРезультата[0];
		сткРез.ТекстПосле = масШаблонРезультата[2];
	КонецЕсли;
	
	Возврат сткРез;
КонецФункции	

