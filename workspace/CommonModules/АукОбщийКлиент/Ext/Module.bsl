КонецПроцедуры

Процедура ЗапускМастераПоРаспределениюУчастниковПоВидам(пФорма) Экспорт
	Оповещение = Новый ОписаниеОповещения("НовыйВидАукциона_Продолжить", АукОбщийКлиент, пФорма);
	
	ПоказатьВопрос(Оповещение, НСтр("ru = 'Вы создали новый вид аукциона. Вы желаете привязать его к участникам и контактным лицам?'"), РежимДиалогаВопрос.ДаНет);
КонецПроцедуры	

Процедура НовыйВидАукциона_Продолжить(Результат, пФорма) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("ВидАукциона", пФорма.Объект.Ссылка);
		
		Оповещение = Новый ОписаниеОповещения("МастерРаспределенияПоУчастникам_Продолжить", АукОбщийКлиент, пФорма);
		
		ОткрытьФорму("Справочник.АукВидыАукционов.Форма.МастерРаспределенияПоУчастникам", ПараметрыФормы,,,,, Оповещение, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	Иначе
		пФорма.ЭтоНовыйВидАукциона = Ложь;
	КонецЕсли;
	
КонецПроцедуры

Процедура МастерРаспределенияПоУчастникам_Продолжить(Результат, пФорма) Экспорт
	
	пФорма.ЭтоНовыйВидАукциона = Ложь;
	
КонецПроцедуры

Процедура ЗаполнитьТабличнуюЧастьПеременнымиПоФормуле(пФормула, пТчПеременные, пТчНастройкаВыбораЗначений, пТчНастройкаСписанияПараметров) Экспорт 
	масРез = АукОбщийВызовСервера.СтрокаНайтиВсеПоРегулярномуВыражениюТолькоЗначения(пФормула,  АукОбщийКлиентСервер.Шаблон_ОперандФормулыРасчетаИтоговБезСкобок(),,, Истина);
	
	// 1. Добавляем отсутсвующие (добавляем циклом, чтобы не сбрасыват установленные флаги)
	Для Сч = 0 По масРез.ВГраница() Цикл			
		Если пТчПеременные.НайтиСтроки(Новый Структура("Переменная", масРез[Сч])).Количество() = 0 Тогда
			НовСтрока = пТчПеременные.Добавить();
			НовСтрока.Переменная = масРез[Сч];	
		КонецЕсли;	
	КонецЦикла;
	
	// 2. Удаляем лишние (чего нет в формуле)
	масСтрокиНаУдаление = Новый Массив;
	Для Каждого СтрокаТз Из пТчПеременные Цикл
		Если масРез.Найти(СтрокаТз.Переменная) = Неопределено Тогда
			масСтрокиНаУдаление.Добавить(СтрокаТз);
			
			АукОбщийКлиентСервер.УдалитьСтрокиТабличнойЧастиПоОтбору(пТчНастройкаВыбораЗначений, Новый Структура("Переменная", СтрокаТз.Переменная));
		КонецЕсли;	
	КонецЦикла;
	
	Для Каждого СтрокаНаУдаление Из масСтрокиНаУдаление Цикл
		АукОбщийКлиентСервер.УдалитьСтрокиТабличнойЧастиПоОтбору(пТчНастройкаСписанияПараметров, Новый Структура("СписыватьПоПеременной", СтрокаНаУдаление.Переменная));
		
		пТчПеременные.Удалить(СтрокаНаУдаление);	
	КонецЦикла;	
КонецПроцедуры

Функция ПреобразоватьСтрокуИмениПеременнойПоФормату(пИсходнаяСтрока) Экспорт
	Возврат "[" + СтрЗаменить(пИсходнаяСтрока, " ", "_") + "]";	
КонецФункции

Функция ОтформатироватьФормулуРасчета(Знач пФормула) Экспорт
	масФормулаТемп = АукОбщийВызовСервера.СтрокаНайтиВсеПоРегулярномуВыражениюТолькоЗначения(пФормула, АукОбщийКлиентСервер.Шаблон_ОперандыИАрифметическиеЗнакиВФормулеРасчетаИтогов());
	
	Для Сч = 0 По масФормулаТемп.ВГраница() Цикл
		масФормулаТемп[Сч] = СтрЗаменить(масФормулаТемп[Сч], " ", "_");	
	КонецЦикла;
	
	Возврат СтрСоединить(масФормулаТемп, " ");
КонецФункции	

Процедура УстановитьПараметрыОтбораДляЭлементаФормы(пИмя, пЗначение, пЭлементФормы) Экспорт
	НовыйПараметр = Новый ПараметрВыбора(пИмя, пЗначение);
	
	НовыеПараметры = Новый ФиксированныйМассив(ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(НовыйПараметр));
	
	пЭлементФормы.ПараметрыВыбора = НовыеПараметры;	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции	

Процедура УставновитьРежимТолькоПросмотрУВсехЭлементовРекурсивно(пФорма, пБулТолькоПросмотр, пМасИсключения) Экспорт
	Для Каждого ПодчиненныйЭлемент Из пФорма.ПодчиненныеЭлементы Цикл
		Если пМасИсключения.Найти(ПодчиненныйЭлемент.Имя) <> Неопределено Тогда
			Продолжить;		
		КонецЕсли;
		
		Если ТипЗнч(ПодчиненныйЭлемент) = Тип("ПолеФормы") Тогда
			ПодчиненныйЭлемент.ТолькоПросмотр = пБулТолькоПросмотр;	
		ИначеЕсли ТипЗнч(ПодчиненныйЭлемент) = Тип("КнопкаФормы") Тогда	
			ПодчиненныйЭлемент.Доступность = Не пБулТолькоПросмотр;	
		ИначеЕсли ТипЗнч(ПодчиненныйЭлемент) = Тип("ТаблицаФормы") Тогда
			ПодчиненныйЭлемент.ТолькоПросмотр = пБулТолькоПросмотр;
			
			УставновитьРежимТолькоПросмотрУВсехЭлементовРекурсивно(ПодчиненныйЭлемент.КоманднаяПанель, пБулТолькоПросмотр, пМасИсключения);
		ИначеЕсли ТипЗнч(ПодчиненныйЭлемент) = Тип("ГруппаФормы") Тогда	
			УставновитьРежимТолькоПросмотрУВсехЭлементовРекурсивно(ПодчиненныйЭлемент, пБулТолькоПросмотр, пМасИсключения);
		КонецЕсли;			
	КонецЦикла;	
КонецПроцедуры

Функция ПодсказкаДляПоляВвода_Наименование()

	ЧастиСтроки = Новый Массив;
	
	ЧастиСтроки.Добавить(СтрШаблон(НСтр("ru = 'Требования к наименованию:%1'"), Символы.ПС)); 
	ЧастиСтроки.Добавить(СтрШаблон(НСтр("ru = '1. Латинские буквы и кириллические в верхнем либо нижнем регистре, а также цифры%1'"), Символы.ПС));
	ЧастиСтроки.Добавить(СтрШаблон(НСтр("ru = '2. Из спецсимволов допускается только: ""_"", ""."", ""("", "")"", пробелы%1'"), Символы.ПС));
	ЧастиСтроки.Добавить(СтрШаблон(НСтр("ru = '3. В базе не должно существовать элементов с таким же наименованием%1%1'"), Символы.ПС));
	ЧастиСтроки.Добавить(СтрШаблон(НСтр("ru = 'Пример:%1'"), Символы.ПС));
	ЧастиСтроки.Добавить(Новый ФорматированнаяСтрока(СтрШаблон(НСтр("ru = 'Неправильно%1'"), Символы.ПС), Новый Шрифт(,,Истина), WebЦвета.Красный));
	ЧастиСтроки.Добавить(СтрШаблон(НСтр("ru = ' [Сумма ставки]%1'"), Символы.ПС));
	ЧастиСтроки.Добавить(СтрШаблон(НСтр("ru = ' Процент/ставки%1'"), Символы.ПС));
	ЧастиСтроки.Добавить(Новый ФорматированнаяСтрока(СтрШаблон(НСтр("ru = 'Правильно%1'"), Символы.ПС), Новый Шрифт(,,Истина), WebЦвета.Зеленый));
	ЧастиСтроки.Добавить(СтрШаблон(НСтр("ru = ' Процент_ставки_5%1'"), Символы.ПС));
