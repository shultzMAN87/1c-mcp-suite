Функция ДанныеАукционаДляПроверки(пДанныеФормы) Экспорт
	сткДанныеАукциона = Новый Структура;
	
	сткДанныеАукциона.Вставить("ДатаНачала",	пДанныеФормы.ДатаНачала);
	сткДанныеАукциона.Вставить("ВидАукциона",	пДанныеФормы.ВидАукциона);
	
	Если Не АукОбщийКлиентСервер.НовыРасчетИтогаВключен() Тогда
		сткДанныеАукциона.Вставить("Сумма",			пДанныеФормы.Сумма);	
		сткДанныеАукциона.Вставить("Срок",			пДанныеФормы.Срок);
	Иначе
		сткДанныеАукциона.Вставить("Параметры",		ВыгрузитьКолонкиВМассивСтруктур(пДанныеФормы.Параметры, "Параметр, ЗначениеПараметра"));
	КонецЕсли;
		
	сткДанныеАукциона.Вставить("Участники",		ОбщегоНазначенияКлиентСервер.ВыгрузитьКолонку(пДанныеФормы.Участники, "Участник", Истина));
	
	масЭтапы = Новый Массив;
	
	Для Каждого ЭлЭтап Из пДанныеФормы.Этапы Цикл
		сткЭтап = Новый Структура("НомерСтроки, Этап, ДлительностьДни, ДлительностьЧасы");
		
		ЗаполнитьЗначенияСвойств(сткЭтап, ЭлЭтап); 
		
		масЭтапы.Добавить(сткЭтап);	
	КонецЦикла;	
		
	сткДанныеАукциона.Вставить("Этапы",				масЭтапы);
	
	сооНачДанные = Новый Соответствие;
	Для Каждого ЭлУчастник Из сткДанныеАукциона.Участники Цикл
		масСтроки = пДанныеФормы.НачальныеДанные.НайтиСтроки(Новый Структура("Участник", ЭлУчастник));
		
		масНачДанные = Новый Массив;
		Для Каждого СтрокаТч Из масСтроки Цикл
			сткСтрокаТч = Новый Структура("СтрокаНачальныхДанных, ЭлементНачальныхДанных, ЗначениеНачальныхДанных");
		
			ЗаполнитьЗначенияСвойств(сткСтрокаТч, СтрокаТч); 
			
			масНачДанные.Добавить(сткСтрокаТч);		
		КонецЦикла;	
		
		Если масНачДанные.Количество() <> 0 Тогда
			сооНачДанные.Вставить(ЭлУчастник, масНачДанные);	
		КонецЕсли;	
	КонецЦикла;		
	
	сткДанныеАукциона.Вставить("НачальныеДанные",		сооНачДанные);
	
	сткНастройкиАвтоматики = Новый Структура("АвтоматическийСтарт,
											| АвтоматическийПереходКПодведениюПромежуточныхИтогов, АвтоматическоеПодведениеПромежуточныхИтогов,
											| АвтоматическийПереходКПодведениюОкончательныхИтогов, АвтоматическоеПодведениеОкончательныхИтогов");
	
	ЗаполнитьЗначенияСвойств(сткНастройкиАвтоматики, пДанныеФормы); 
	сткДанныеАукциона.Вставить("НастройкиАвтоматики",	сткНастройкиАвтоматики);
	
	Возврат сткДанныеАукциона;
КонецФункции

