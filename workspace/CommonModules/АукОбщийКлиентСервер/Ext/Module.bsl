Процедура УдалитьСтрокиТаблицыПоСтруктуреОтборов(пТаблица, пСткОтбор) Экспорт
	масСтрокиНаУдаление = пТаблица.НайтиСтроки(пСткОтбор);
	
	Для Каждого ЭлСтрока Из масСтрокиНаУдаление Цикл
		
		пТаблица.Удалить(ЭлСтрока);
		
	КонецЦикла;	
КонецПроцедуры	

Функция КолонкаТаблицыВМассивСОтборомПоТипу(КоллекцияСтрок, ИмяКолонки, ИмяКолонкиСТипом, ОтборТип) Экспорт
	МассивЗначений = Новый Массив;
	
	Для каждого СтрокаКоллекции Из КоллекцияСтрок Цикл
		Если ТипЗначенияЭлементаПвхСоответствуетТипу(СтрокаКоллекции[ИмяКолонкиСТипом], ОтборТип) Тогда 
			Значение = СтрокаКоллекции[ИмяКолонки];

			МассивЗначений.Добавить(Значение);
		КонецЕсли;
	КонецЦикла; 
	
	Возврат МассивЗначений;	
КонецФункции	

Функция ОтобратьЭлементыВМассивеСтруктур(пМассив, пСткОтбор) Экспорт
	НовыйМассив = Новый Массив;
	
	Для Каждого ЭлементМассива Из пМассив Цикл
		Если ЭлементКоллекцииПодходитПоОтбор(ЭлементМассива, пСткОтбор) Тогда
			НовыйМассив.Добавить(ЭлементМассива);
		КонецЕсли;
	КонецЦикла;	
	
	Возврат НовыйМассив;
КонецФункции	

Функция ДанныеПобедителяЭтапаИзТаблицыРезультатовЭтапа(пАукцион, пНомерЭтапа, пСтрокаТаблицы) Экспорт
	сткДанные = Новый Структура;
	
	сткДанные.Вставить("Аукцион",				пАукцион);
	сткДанные.Вставить("НомерЭтапа",			пНомерЭтапа);
	
	сткДанные.Вставить("ДатаСтавки",			пСтрокаТаблицы.ДатаСтавки);	
	сткДанные.Вставить("Участник",				пСтрокаТаблицы.Участник);
	сткДанные.Вставить("СтрокаДанных",			пСтрокаТаблицы.СтрокаДанных);	
	сткДанные.Вставить("РезультатРасчета",		пСтрокаТаблицы.РезультатРасчета);
	
	сткДанные.Вставить("ПредставлениеРезультатаРасчета",	пСтрокаТаблицы.ПредставлениеРезультатаРасчета);
	
	Возврат сткДанные;	
КонецФункции

Функция ДанныеПобедителейИзТаблицРезультатов(пДанные) Экспорт
	сткДанные = Новый Структура;
	сткДанные.Вставить("Аукцион",		пДанные.Аукцион);
	сткДанные.Вставить("НомерЭтапа",	пДанные.НомерЭтапа);
	
	сткДанные.Вставить("ПараметрыАукциона",	ПараметрыАукционаИзДанныхРасчетаИтогов(пДанные.тзПараметрыАукциона));
	сткДанные.Вставить("ПеременныеФормулы",	ПеременныеФормулыИзДанныхРасчетаИтогов(пДанные.тзИтогиАукциона, пДанные.Переменные));
	сткДанные.Вставить("РезультатыРасчета",	РезультатыРасчетаИзДанныхРасчетаИтогов(пДанные.тзИтогиАукциона));
	
	Возврат сткДанные;	
КонецФункции

