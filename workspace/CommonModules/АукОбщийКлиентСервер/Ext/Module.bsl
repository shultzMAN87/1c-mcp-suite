	масРезультат = Новый Массив;
	
	Для Каждого ЭлементМассива Из пМассив Цикл	
		масРезультат.Добавить(Новый Структура(пКлючСтруктуры, ЭлементМассива));		
	КонецЦикла;
	
	Возврат масРезультат		
КонецФункции

