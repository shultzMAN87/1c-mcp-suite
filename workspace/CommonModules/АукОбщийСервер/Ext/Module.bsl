Процедура ДобавитьЗначениеПараметра_УЧАСТНИК_КОНТАКТНОЕ_ЛИЦО_ИМЯ(пСооРезультат, пСтрПараметрИмя, пСткДанные)
	Если пСткДанные.Свойство("КонтактноеЛицо") Тогда
		пСооРезультат.Вставить(пСтрПараметрИмя, Справочники.АукКонтактныеЛицаУчастниковАукционов.ДанныеКонтактногоЛица(пСткДанные.КонтактноеЛицо).Имя);
	Иначе
		пСооРезультат.Вставить(пСтрПараметрИмя, "---");	
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

