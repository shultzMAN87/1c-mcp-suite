			пСооРезультат.Вставить(пСтрПараметрИмя, СтрШаблон(НСтр("ru = '%1 (GMT+10, Владивосток)'"), Формат(пСткДанные.Период, "ДФ=dd.MM.yyyy HH:mm; ДЛФ=DT")));
		Иначе
			пСооРезультат.Вставить(пСтрПараметрИмя, "---");
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

