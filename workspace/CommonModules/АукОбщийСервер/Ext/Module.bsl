		КонецЕсли;
		
		пСооРезультат.Вставить(пСтрПараметрИмя, Формат(пСткДанные.ТекущееСостояниеАукциона.НомерЭтапа, "ЧГ=0"));
	КонецЕсли;
КонецПроцедуры

Процедура ДобавитьЗначениеПараметра_АУКЦИОН_ВСЕГО_ЭТАПОВ(пСооРезультат, пСтрПараметрИмя, пСткДанные)
