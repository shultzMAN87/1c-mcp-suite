	РегистрыСведений.АукИсторияКомандАукционов.ЗафиксироватьКомандуДляВыполнения_(сткДанные);
	
	пСткПараметры.Вставить("КлючКоманды", сткДанные.КлючКоманды);
КонецПроцедуры

