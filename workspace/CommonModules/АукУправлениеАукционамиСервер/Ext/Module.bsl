Функция РассчитатьИтогиАукциона_ВыполнениеВозможно(пАукцион)

	сткТекСостояниеАукциона = РегистрыСведений.АукИсторияСтатусовАукционов.ТекущееСостояниеАукциона(пАукцион);
	
	Если сткТекСостояниеАукциона.Статус <> ПредопределенноеЗначение("Перечисление.АукСтатусыАукционов.ПодведениеИтогов") Тогда
		
		стрТекстОшибки = СтрШаблон(НСтр("ru = 'Текущий статус аукциона <%1> не позволяет выполнить подведение окончательных итогов'"), сткТекСостояниеАукциона.Статус);
		
		Возврат ЭдоОбщий._Ошибка(стрТекстОшибки);
		
	КонецЕсли;	
	
	Возврат ЭдоОбщий._Успех();
	
КонецФункции

Функция ЗафиксироватьИтогиАукциона_ВыполнениеВозможно(пАукцион)

	сткТекСостояниеАукциона = РегистрыСведений.АукИсторияСтатусовАукционов.ТекущееСостояниеАукциона(пАукцион);
	
	Если сткТекСостояниеАукциона.Статус <> ПредопределенноеЗначение("Перечисление.АукСтатусыАукционов.ПодведениеИтогов") Тогда
		
		стрТекстОшибки = СтрШаблон(НСтр("ru = 'Текущий статус аукциона <%1> не позволяет выполнить подведение окончательных итогов'"), сткТекСостояниеАукциона.Статус);
		
		Возврат ЭдоОбщий._Ошибка(стрТекстОшибки);
		
	КонецЕсли;	
	
	Возврат ЭдоОбщий._Успех();
	
КонецФункции

Функция ОтменитьАукцион_ВыполнениеВозможно(пАукцион)

	сткТекСостояниеАукциона = РегистрыСведений.АукИсторияСтатусовАукционов.ТекущееСостояниеАукциона(пАукцион);
	
	Если сткТекСостояниеАукциона.Статус <> ПредопределенноеЗначение("Перечисление.АукСтатусыАукционов.НовыйЭтап")
		 И сткТекСостояниеАукциона.Статус <> ПредопределенноеЗначение("Перечисление.АукСтатусыАукционов.ПодведениеПромежуточныхИтогов")
	Тогда
		
		стрТекстОшибки = СтрШаблон(НСтр("ru = 'Текущий статус аукциона <%1> не позволяет выполнить отмену аукциона'"), сткТекСостояниеАукциона.Статус);
		
		Возврат ЭдоОбщий._Ошибка(стрТекстОшибки);
		
	КонецЕсли;	
	
	Возврат ЭдоОбщий._Успех();
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Адаптер
//
Функция ПолучитьДанныеОтУчастника_ДанныеРассылки(пСткДанныеКоманды, пТекПериод)
	сткДанныеУчастника = Новый Структура;
	сткДанныеУчастника.Вставить("Участник",	пСткДанныеКоманды.Участник);
	сткДанныеУчастника.Вставить("Период",	пТекПериод);
	
	масУчастники = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(сткДанныеУчастника);
	
	ВидСообщения = пСткДанныеКоманды.ДанныеКоманды.required_data.message_type;
	
	тзКонтактныеЛицаУчастников = Новый ТаблицаЗначений;
	тзКонтактныеЛицаУчастников.Колонки.Добавить("Участник",	Новый ОписаниеТипов("СправочникСсылка.АукУчастникиАукционов"));
	тзКонтактныеЛицаУчастников.Колонки.Добавить("КонтактноеЛицо",	Новый ОписаниеТипов("СправочникСсылка.АукКонтактныеЛицаУчастниковАукционов"));
	
	НовСтрока = тзКонтактныеЛицаУчастников.Добавить();
	НовСтрока.Участник = пСткДанныеКоманды.Участник;
	НовСтрока.КонтактноеЛицо = пСткДанныеКоманды.КонтактноеЛицо;
	
	Возврат ДанныеРассылкиПоСпискуУчастников(масУчастники, пСткДанныеКоманды.Аукцион, ВидСообщения, тзКонтактныеЛицаУчастников) 
КонецФункции

// Адаптер
//
Функция ДанныеРассылкиПоУчастникамПобедителям(пСткПараметры, пВидСообщения)	
	Если Не АукОбщийКлиентСервер.НовыРасчетИтогаВключен() Тогда
		масДанныеПобедителей = РегистрыСведений.АукДанныеТаблицПодведенияИтогов.СведенияОПобедителяхАукциона(пСткПараметры.Аукцион);
	Иначе
		масДанныеПобедителей = РегистрыСведений.АукРасчетИтоговРезультаты.ПобедителиАукционаПоРезультатамРасчета(пСткПараметры.Аукцион, пСткПараметры.НомерЭтапа);	
	КонецЕсли;	
	
	Возврат ДанныеРассылкиПоСпискуУчастников(масДанныеПобедителей, пСткПараметры.Аукцион, пВидСообщения) 
КонецФункции

Функция ДанныеРассылкиПоВсемУчастникам(пАукцион, пВидСообщения)
	масУчастники = Справочники.АукАукционы.УчастникиАукциона(пАукцион, Истина);
	
	Возврат ДанныеРассылкиПоСпискуУчастников(масУчастники, пАукцион, пВидСообщения) 
КонецФункции

Функция ДанныеРассылкиПоСпискуУчастников(пМасУчастники, пАукцион, пВидСообщения, пТзКонтактныеЛицаУчастников = Неопределено, пТекстСообщения = "")
	Если пТзКонтактныеЛицаУчастников = Неопределено Тогда
		пТзКонтактныеЛицаУчастников = Справочники.АукАукционы.КонтактныеЛицаСПривязкойКУчастникам(пАукцион);
	КонецЕсли;
	
	масКонтактныеЛица = пТзКонтактныеЛицаУчастников.ВыгрузитьКолонку("КонтактноеЛицо");
	
	// 2. Канал взаимодействия + настройки
	сооРез = Справочники.АукКонтактныеЛицаУчастниковАукционов.ТекущиеКонтактныеДанныеКонтактныхЛиц(масКонтактныеЛица);
	
	// 3. Ключевые данные аукциона
	сткКлючевыеДанныеАукциона = Справочники.АукАукционы.КлючевыеДанныеАукциона(пАукцион);
	
	// 4. Получаем шаблоны текста и заголовка из РС АукШаблоныСообщений для каждого участника. Они могут быть разные
	сткОтбор = Новый Структура;
	сткОтбор.Вставить("ВидСообщения",		пВидСообщения);
	сткОтбор.Вставить("ВидАукциона",		сткКлючевыеДанныеАукциона.ВидАукциона);
	сткОтбор.Вставить("Участники",			ОбщегоНазначенияКлиентСервер.ВыгрузитьКолонку(пМасУчастники, "Участник", Истина));
	
	сооШаблоныСообщений = РегистрыСведений.АукШаблоныСообщений.ШаблонСообщенияУчастникуПоОтбору(сткОтбор);
	
	// 5. Из всех шаблонов нужно извлечь Параметры (вида [ТЕКСТ_ТЕКСТ]), чтобы получить их значения
	// параметры условно можно разделить на 2 категории: "Общие" и "Индивидуальные".
	// Для получения значений "общих" достаточно ссылки на аукцион. Их мы сразу отбираем и ищем по ним значения
	// Для получения значений "индивидуальных" нужны индивидуальные значения типа Участник, Контактное лицо и т.д.
	масПараметрыОбщие = Новый Массив;

	Для Каждого СткЭлСоо Из сооШаблоныСообщений Цикл
		СткЭлСоо.Значение.Шаблон = ?(ЗначениеЗаполнено(пТекстСообщения), пТекстСообщения, СткЭлСоо.Значение.Шаблон);
		
		сткПараметрыШаблонов = РегистрыСведений.АукШаблоныСообщений.ПараметрыШаблоновПоШаблону(
																СткЭлСоо.Значение.Шаблон + " " + СткЭлСоо.Значение.Заголовок);
		
		СткЭлСоо.Значение.Вставить("ПараметрыШаблонов", сткПараметрыШаблонов);
		
		ОбщегоНазначенияКлиентСервер.ДополнитьМассив(масПараметрыОбщие, сткПараметрыШаблонов.Общие, Истина);
	КонецЦикла;
	
	// 6. Получение значений общих параметров
	сткПараметрыДанных = Новый Структура;
	сткПараметрыДанных.Вставить("Аукцион",			пАукцион);
	сткПараметрыДанных.Вставить("КлючевыеДанные",	сткКлючевыеДанныеАукциона);
	
	сооЗначПараметровШаблоновОбщие = АукОбщийСервер.ЗначенияПараметровШаблонов_Общие(масПараметрыОбщие, сткПараметрыДанных); 
		
	масРезультат = Новый Массив;
	Для Каждого сткЭлУчастник Из пМасУчастники Цикл
		масСтрокиТзУчастники = пТзКонтактныеЛицаУчастников.НайтиСтроки(Новый Структура("Участник", сткЭлУчастник.Участник));
		
		Для Сч_ = 0 По масСтрокиТзУчастники.ВГраница() Цикл	
			сткДанныеСообщения = ДанныеСообщенияПоКонтактномЛицу(масСтрокиТзУчастники, сткЭлУчастник, сооШаблоныСообщений,
																		сооЗначПараметровШаблоновОбщие, сткПараметрыДанных, сооРез, Сч_);
			
			масРезультат.Добавить(сткДанныеСообщения);	
		КонецЦикла;	
	КонецЦикла;
	
	Возврат масРезультат;	
КонецФункции	

Функция ДанныеСообщенияПоКонтактномЛицу(пМасСтрокиТзУчастники, пСткЭлУчастник, пСооШаблоныСообщений, пСооЗначПараметровШаблоновОбщие, пСткПараметрыДанных, пСооРез, пСч_)
	сткДанныеСообщения = Новый Структура;
	
	сткДанныеСообщения.Вставить("Участник",			пСткЭлУчастник.Участник);
	сткДанныеСообщения.Вставить("КонтактноеЛицо",	пМасСтрокиТзУчастники[пСч_].КонтактноеЛицо);
	сткДанныеСообщения.Вставить("СтрокаДанных",		пСч_);
	
	Если пСооШаблоныСообщений <> Неопределено Тогда
		сткНастройкиСообщения = пСооШаблоныСообщений.Получить(пСткЭлУчастник.Участник);
		
		сткДанныеСообщения.Вставить("ТекстСообщения",	сткНастройкиСообщения.Шаблон);
		сткДанныеСообщения.Вставить("ТемаСообщения",	сткНастройкиСообщения.Заголовок);
		
		масРез = Новый Массив;
		
		// 1. Обработаем значения общих параметров
		Для Каждого ЭлМас Из сткНастройкиСообщения.ПараметрыШаблонов.Общие Цикл
			масРез.Добавить(Новый Структура("NameParam, ValueParam", ЭлМас, пСооЗначПараметровШаблоновОбщие.Получить(ЭлМас)));	
		КонецЦикла;
		
		пСткПараметрыДанных.Вставить("Участник",		сткДанныеСообщения.Участник);
		пСткПараметрыДанных.Вставить("КонтактноеЛицо",	сткДанныеСообщения.КонтактноеЛицо);
		
		Если пСткЭлУчастник.Свойство("СтрокаДанных") Тогда
			пСткПараметрыДанных.Вставить("СтрокаДанных",	пСткЭлУчастник.СтрокаДанных);	
		КонецЕсли;
		
		Если пСткЭлУчастник.Свойство("Период") Тогда
			пСткПараметрыДанных.Вставить("Период",	пСткЭлУчастник.Период);	
		КонецЕсли;
		
		// 2. Получим и обработаем индивидуальные параметры
		Если сткНастройкиСообщения.ПараметрыШаблонов.Индивидуальные.Количество() <> 0 Тогда
			сооЗначПараметровШаблоновИндив = АукОбщийСервер.ЗначенияПараметровШаблонов_Индивидуальные(сткНастройкиСообщения.ПараметрыШаблонов.Индивидуальные,
																										пСткПараметрыДанных);
			
			Для Каждого ЭлМас Из сткНастройкиСообщения.ПараметрыШаблонов.Индивидуальные Цикл
				масРез.Добавить(Новый Структура("NameParam, ValueParam", ЭлМас, сооЗначПараметровШаблоновИндив.Получить(ЭлМас)));	
			КонецЦикла;
		КонецЕсли;
		
		сткДанныеСообщения.Вставить("ЗначенияПараметровШаблонов", масРез);
		
	Иначе
		сткДанныеСообщения.Вставить("ТекстСообщения",	Неопределено);
		сткДанныеСообщения.Вставить("ТемаСообщения",	Неопределено);
		сткДанныеСообщения.Вставить("ЗначенияПараметровШаблонов", Неопределено);
	КонецЕсли;	
	
	сткДанныеКанала = пСооРез.Получить(пМасСтрокиТзУчастники[пСч_].КонтактноеЛицо);
	
	Если сткДанныеКанала <> Неопределено Тогда
		сткДанныеСообщения.Вставить("Канал",			сткДанныеКанала.КаналВзаимодействия);
		сткДанныеСообщения.Вставить("НастройкиКанала",	сткДанныеКанала.НастройкиКаналаВзаимодействия);
	Иначе
		сткДанныеСообщения.Вставить("Канал",			Неопределено);
		сткДанныеСообщения.Вставить("НастройкиКанала",	Неопределено);
	КонецЕсли;
	
	Возврат сткДанныеСообщения;
КонецФункции

Функция СообщенияАвторам_ДанныеРассылки(пСткПараметрыОповещения)
	сткДанныеРассылки = Новый Структура("ТемаСообщения, ТекстСообщения, ЗначенияПараметровШаблонов",,, Новый Массив);
	
	// 1. Получаем шаблон из РС АукШаблоныСообщений
	сткОтбор = Новый Структура;
	сткОтбор.Вставить("ВидСообщения",	пСткПараметрыОповещения.ВидСообщения);
	сткОтбор.Вставить("ВидАукциона",	Справочники.АукАукционы.КлючевыеДанныеАукциона(пСткПараметрыОповещения.Аукцион).ВидАукциона);
	
	сткШаблоны = РегистрыСведений.АукШаблоныСообщений.ШаблонСообщенияАвторуПоОтбору(сткОтбор);
	
	Если сткШаблоны = Неопределено Тогда
		Возврат сткДанныеРассылки;	
	КонецЕсли;
	
	сткДанныеРассылки.ТемаСообщения		= сткШаблоны.Заголовок;
	сткДанныеРассылки.ТекстСообщения	= сткШаблоны.Шаблон;
	
	масПараметрыШаблонов = АукОбщийВызовСервера.СтрокаНайтиВсеПоРегулярномуВыражениюТолькоЗначения(сткШаблоны.Шаблон + " " + сткШаблоны.Заголовок,
																							АукОбщийКлиентСервер.Шаблон_ПараметрыШаблонаСообщения(),,, Истина);
	
	сткПараметрыШаблонов = Новый Структура;
	сткПараметрыШаблонов.Вставить("Аукцион", пСткПараметрыОповещения.Аукцион);
	
	сооЗначенияПараметровШаблонов = АукОбщийСервер.ЗначенияПараметровШаблонов_Общие(масПараметрыШаблонов, сткПараметрыШаблонов);
	
	Для Каждого ЭлСоо Из сооЗначенияПараметровШаблонов Цикл
		сткДанныеРассылки.ЗначенияПараметровШаблонов.Добавить(Новый Структура("NameParam, ValueParam", ЭлСоо.Ключ, ЭлСоо.Значение));	
	КонецЦикла;
	
	Возврат сткДанныеРассылки;	
КонецФункции	

#КонецОбласти

