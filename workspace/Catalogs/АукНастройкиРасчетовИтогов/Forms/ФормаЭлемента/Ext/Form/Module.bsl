
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ПодпискиНаСобытияФорм.Справочник_ПриСозданииНаСервере(ЭтотОбъект, Отказ, СтандартнаяОбработка);
	Если (Отказ) Тогда
		Возврат;
	КонецЕсли;
	
	Если Не Параметры.ДополнительныеПараметры.Свойство("ОткрытиеИзФормыВладельца") Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Эта форма может быть открыта только с формы Вид аукциона!'"),,,, Отказ);
		
		Возврат;	
	КонецЕсли;
		
	НачальнаяИнициализация();
	
	ПодпискиНаСобытияФорм.Справочник_ПослеСозданияНаСервере(ЭтотОбъект, Отказ, СтандартнаяОбработка);
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ПодпискиНаСобытияФормКлиент.Справочник_ПриОткрытии(ЭтотОбъект, Отказ);	
	Если Отказ Тогда 
		Возврат; 
	КонецЕсли;
	
	НастроитьИнтерфейс();
	
	ПодпискиНаСобытияФормКлиент.Справочник_ПослеОткрытия(ЭтотОбъект, Отказ);
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	Если Не ПроверитьЗаполнение() Тогда
		Отказ = Истина;
		
		Возврат;
	КонецЕсли;
	
	ЗаполнитьШаблонРезультатаИзДанныхФормы();
	
	Если ПроверитьЗаполнениеКастомное(Отказ) Тогда
		сткПараметры = Новый Структура;
		сткПараметры.Вставить("Формула",			Объект.Формула);
		сткПараметры.Вставить("Переменные", 		ОбщегоНазначенияКлиентСервер.ВыгрузитьКолонку(Объект.Переменные, "Переменная"));
		сткПараметры.Вставить("ЗначенияПеременных", ОбщегоНазначенияКлиентСервер.ВыгрузитьКолонку(
																	Объект.НастройкаВыбораЗначенийПеременных, "Переменная"));
		
		сткРез = АукОбщийВызовСервера.ПроверитьФормулуРасчетаИСписокПеременных(сткПараметры);
		
		Если Не сткРез.Успех Тогда
			Отказ = Истина;
			
			ОбщегоНазначенияКлиент.СообщитьПользователю(сткРез.Результат);
			
			Возврат;
		КонецЕсли;	
	КонецЕсли;	
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	ТекущийОбъект.Формула = АукОбщийСервер.НормализоватьСтрокуФормулы(ТекущийОбъект.Формула);
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура ПеременныеПриАктивизацииСтроки(Элемент)
	ТекДанные = Элемент.ТекущиеДанные;
	
	Если ТекДанные <> Неопределено Тогда	
		УстановитьОтборЗначенийПеременной(ТекДанные.НомерСтроки);	
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура НастройкаВыбораЗначенийПеременныхПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)	
	Отказ = Истина;
	
	Если Не Копирование Тогда	
		ДобавитьЗначениеПеременнойПоПеременной();
	КонецЕсли;		
КонецПроцедуры

&НаКлиенте
Процедура НастройкаВыбораЗначенийПеременныхПриАктивизацииСтроки(Элемент)	
	УстановитьОтобрыНаПолеВыбора(Элемент);
КонецПроцедуры

&НаКлиенте
Процедура НастройкаВыбораЗначенийПеременныхПриАктивизацииПоля(Элемент)
	Если Элемент.ТекущийЭлемент.Имя = "НастройкаВыбораЗначенийПеременныхЗначениеДанных" Тогда
		УстановитьОтобрыНаПолеВыбора(Элемент);	
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ПеременныеПередУдалением(Элемент, Отказ)
	ТекДанные = Элемент.ТекущиеДанные;
	
	Если ТекДанные <> Неопределено Тогда
		АукОбщийКлиентСервер.УдалитьСтрокиТаблицыПоСтруктуреОтборов(Объект.НастройкаВыбораЗначенийПеременных, Новый Структура("Переменная", ТекДанные.Переменная));	
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура НастройкаСписанияПараметровПриАктивизацииПоля(Элемент)
	Если Элемент.ТекущийЭлемент.Имя = "НастройкаСписанияПараметровСписыватьПоПеременной" Тогда 
		Элемент.ТекущийЭлемент.СписокВыбора.Очистить();
		
		Элемент.ТекущийЭлемент.СписокВыбора.ЗагрузитьЗначения(ОбщегоНазначенияКлиентСервер.ВыгрузитьКолонку(Объект.Переменные, "Переменная", Истина));
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ШаблонРезультатаТекстДоПриИзменении(Элемент)
	Модифицированность = Истина;
	
	ОбновитьПримерШаблонаРезультата();
КонецПроцедуры

&НаКлиенте
Процедура ШаблонРезультатаТекстПослеПриИзменении(Элемент)
	Модифицированность = Истина;
	
	ОбновитьПримерШаблонаРезультата();
КонецПроцедуры

&НаКлиенте
Процедура НастройкаВыбораЗначенийПеременныхЗначениеДанныхОбработкаВыбора(Элемент, ВыбранноеЗначение, ДополнительныеДанные, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	
	ТекДанные = Элементы.НастройкаВыбораЗначенийПеременных.ТекущиеДанные;
	
	Если ТекДанные <> Неопределено Тогда
		ВыборНастройкиРасчетовИтогов_ОбработкаВыбора(ВыбранноеЗначение, ТекДанные);	
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура НастройкаВыбораЗначенийПеременныхЗначениеДанныхНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	
	ТекДанные = Элементы.НастройкаВыбораЗначенийПеременных.ТекущиеДанные;
	
	Если ТекДанные <> Неопределено Тогда
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("ЗапретитьСоздание", Истина);
		
		масЗначения = ЭтотОбъект.ЗначенияДанныхИзВидаАукциона.Получить(ТекДанные.ИсточникДанных);
		
		Если масЗначения <> Неопределено Тогда
			ПараметрыФормы.Вставить("Отбор", Новый Структура("Ссылка", масЗначения));	
		Иначе
			ПараметрыФормы.Вставить("Отбор", Новый Структура("ЭтоЭлементПредопределенныхДанных", Истина));	
		КонецЕсли;
		
		Оповещение = Новый ОписаниеОповещения("ВыборНастройкиРасчетовИтогов_Продолжить", ЭтотОбъект, ТекДанные);
		
		ОткрытьФорму("ПланВидовХарактеристик.АукЭлементыДанныхАукционов.ФормаВыбора", ПараметрыФормы, ЭтотОбъект,,,, Оповещение);
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура НастройкаВыбораЗначенийПеременныхИсточникДанныхПриИзменении(Элемент)
	ТекДанные = Элементы.НастройкаВыбораЗначенийПеременных.ТекущиеДанные;
	
	Если ТекДанные <> Неопределено Тогда
		ТекДанные.ЗначениеДанных = Неопределено;	
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ФормулаПриИзменении(Элемент)
	Объект.Формула = АукОбщийКлиент.ОтформатироватьФормулуРасчета(Объект.Формула);
КонецПроцедуры

&НаКлиенте
Процедура НастройкаСписанияПараметровСписыватьПоПеременнойОбработкаВыбора(Элемент, ВыбранноеЗначение, ДополнительныеДанные, СтандартнаяОбработка)
	ТекДанные = Элементы.НастройкаСписанияПараметров.ТекущиеДанные;
	
	Если ТекДанные <> Неопределено Тогда
		Если Объект.НастройкаСписанияПараметров.НайтиСтроки(Новый Структура("Параметр, СписыватьПоПеременной", ТекДанные.Параметр, ВыбранноеЗначение)).Количество() <> 0 Тогда
			СтандартнаяОбработка = Ложь;
			
			ОбщегоНазначенияКлиент.СообщитьПользователю(СтрШаблон(НСтр("ru = 'Для параметра <%1> уже указана такая переменная'"), ТекДанные.Параметр));
		КонецЕсли;	
	КонецЕсли;	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКоманд

&НаКлиенте
Процедура ЗаполнитьСписокПеременных(Команда)
	ЗаполнитьСписокПеременныхПоСтрокеФормулы();	
КонецПроцедуры

&НаКлиенте
Процедура ПреобразоватьВПеременную(Команда)
	Элементы.Формула.ВыделенныйТекст = АукОбщийКлиент.ПреобразоватьСтрокуИмениПеременнойПоФормату(Элементы.Формула.ВыделенныйТекст);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ЗаполнитьШаблонРезультатаИзДанныхФормы()
	Объект.ШаблонРезультата = ЭтотОбъект.ШаблонРезультатаТекстДо + АукОбщийКлиентСервер.ОперандПредставленияПромежуточногоИтога() + ЭтотОбъект.ШаблонРезультатаТекстПосле;	
КонецПроцедуры	

&НаКлиенте
Процедура НастроитьИнтерфейс()
	масЗначения = ЭтотОбъект.ЗначенияДанныхИзВидаАукциона.Получить(ПредопределенноеЗначение("Перечисление.АукИсточникиЗначенийПеременных.ПараметрАукциона"));
	
	Если масЗначения <> Неопределено Тогда
		АукОбщийКлиент.УстановитьПараметрыОтбораДляЭлементаФормы("Отбор.Ссылка", масЗначения, Элементы.НастройкаСписанияПараметровПараметр);
	КонецЕсли;														  
	
	// Обновить пример шаблона результат
	ОбновитьПримерШаблонаРезультата();
	
	Элементы.ГруппаШаблонРезультата.Видимость = ЭтотОбъект.ЭтоНастройкаРасчетовПромежуточногоИтога;	
	
	Элементы.НастройкаСписанияПараметров.Видимость = Не ЭтотОбъект.ЭтоНастройкаРасчетовПромежуточногоИтога;
	
	// Блокировать изменения
	//Если ЭтотОбъект.БлокироватьИзмененияДанных Тогда
	//	АукОбщийКлиент.УставновитьРежимТолькоПросмотрУВсехЭлементов(ЭтотОбъект);
	//Иначе
	//	Элементы.НадписьЗапретРедактирования.Видимость = Ложь;
	//КонецЕсли;
КонецПроцедуры	

&НаКлиенте
Процедура ОбновитьПримерШаблонаРезультата()
	масФормСтрока = Новый Массив;
	масФормСтрока.Добавить(Новый ФорматированнаяСтрока("Пример: ", Новый Шрифт(Истина, ,)));
	масФормСтрока.Добавить(Новый ФорматированнаяСтрока(ЭтотОбъект.ШаблонРезультатаТекстДо + "10" + ЭтотОбъект.ШаблонРезультатаТекстПосле, Новый Шрифт(,, Истина)));
		
	Элементы.ШаблонРезультатаПример.Заголовок = Новый ФорматированнаяСтрока(масФормСтрока);	
КонецПроцедуры	

&НаКлиенте
Процедура УстановитьОтобрыНаПолеВыбора(пЭлемент)
	ТекДанные = пЭлемент.ТекущиеДанные;
	
	Если ТекДанные <> Неопределено Тогда
		масЗначения = ЭтотОбъект.ЗначенияДанныхИзВидаАукциона.Получить(ТекДанные.ИсточникДанных);
		
		Если масЗначения <> Неопределено Тогда
			АукОбщийКлиент.УстановитьПараметрыОтбораДляЭлементаФормы("Отбор.Ссылка", масЗначения, Элементы.НастройкаВыбораЗначенийПеременныхЗначениеДанных);	
		Иначе
			АукОбщийКлиент.УстановитьПараметрыОтбораДляЭлементаФормы("Отбор.ЭтоЭлементПредопределенныхДанных",
																	  Истина,
																	  Элементы.НастройкаВыбораЗначенийПеременныхЗначениеДанных);
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Функция ПроверитьЗаполнениеКастомное(пОтказ)
	булРезультат = Истина;
	
	Если ЭтотОбъект.ЭтоНастройкаРасчетовПромежуточногоИтога Тогда
		Если Не ЗначениеЗаполнено(Объект.ШаблонРезультата) Тогда
			ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Не заполнено представление результата'"),,, "Объект.ШаблонРезультата", пОтказ);
			
			булРезультат = Ложь;
		КонецЕсли;	
	КонецЕсли;
	
	Возврат булРезультат;
КонецФункции	

&НаСервере
Процедура НачальнаяИнициализация()
	Если Параметры.ДополнительныеПараметры.Свойство("ЭтоНастройкаРасчетовПромежуточногоИтога") Тогда
		ЭтотОбъект.ЭтоНастройкаРасчетовПромежуточногоИтога = Параметры.ДополнительныеПараметры.ЭтоНастройкаРасчетовПромежуточногоИтога;	
	КонецЕсли;	
	
	ЭтотОбъект.ЗначенияДанныхИзВидаАукциона = Новый ФиксированноеСоответствие(Справочники.АукВидыАукционов.ОписаниеДанныхСвязанныхСАукциономПоВидуТолькоЗначения(Объект.Владелец));
	
	Если Параметры.Ключ.Пустая() Тогда
		Объект.ВидРезультата = АукОбщийКлиентСервер.ВидРезультатРасчетаИтогаПоУмолчанию();
	Иначе
		сткРез = АукОбщийВызовСервера.ТекстДоИПослеВШаблонеРезультатаРасчета(Объект.ШаблонРезультата);
		
		ЭтотОбъект.ШаблонРезультатаТекстДо		= сткРез.ТекстДо;
		ЭтотОбъект.ШаблонРезультатаТекстПосле	= сткРез.ТекстПосле;
		
		// Инициализировать флаг "БлокироватьИзмененияДанных"
		ЭтотОбъект.БлокироватьИзмененияДанных = Справочники.АукАукционы.ЕстьАукционыСВидом(Объект.Владелец);
	КонецЕсли;
КонецПроцедуры	

&НаКлиенте
Процедура ЗаполнитьСписокПеременныхПоСтрокеФормулы()
	АукОбщийКлиент.ЗаполнитьТабличнуюЧастьПеременнымиПоФормуле(Объект.Формула, Объект.Переменные, Объект.НастройкаВыбораЗначенийПеременных, Объект.НастройкаСписанияПараметров);
	
	Модифицированность = Истина;
КонецПроцедуры

&НаКлиенте
Процедура УстановитьОтборЗначенийПеременной(Знач НомерСтроки)
	//Если Не ЗначениеЗаполнено(пПеременная) Тогда
	//	пПеременная = "[]";	
	//КонецЕсли;
	
	Элементы.НастройкаВыбораЗначенийПеременных.ОтборСтрок = Новый ФиксированнаяСтруктура("ПеременнаяНомерСтроки", НомерСтроки);
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьЗначениеПеременнойПоПеременной()

	ПеременныеТекДанные = Элементы.Переменные.ТекущиеДанные;
	
	Если ПеременныеТекДанные = Неопределено Или Не ЗначениеЗаполнено(ПеременныеТекДанные.Переменная) Тогда 

		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Укажите имя переменной'"));
		
	Иначе	
		НовСтрока = Объект.НастройкаВыбораЗначенийПеременных.Добавить();
		
		НовСтрока.Переменная			= ПеременныеТекДанные.Переменная;
		НовСтрока.ПеременнаяНомерСтроки	= ПеременныеТекДанные.НомерСтроки;
		
		УстановитьОтборЗначенийПеременной(ПеременныеТекДанные.НомерСтроки);										   
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыборНастройкиРасчетовИтогов_Продолжить(Результат, пТекДанные) Экспорт
	Если Результат <> Неопределено Тогда	
		ВыборНастройкиРасчетовИтогов_ОбработкаВыбора(Результат, пТекДанные);
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ВыборНастройкиРасчетовИтогов_ОбработкаВыбора(Результат, пТекДанные)
	сткОтбор = Новый Структура;
	сткОтбор.Вставить("Переменная",		пТекДанные.Переменная);
	//сткОтбор.Вставить("ПеременнаяНомерСтроки",		пТекДанные.ПеременнаяНомерСтроки);
	сткОтбор.Вставить("ИсточникДанных", пТекДанные.ИсточникДанных);
	сткОтбор.Вставить("ЗначениеДанных", Результат);
	
	Если пТекДанные.ЗначениеДанных <> Результат Тогда
		
		Если Объект.НастройкаВыбораЗначенийПеременных.НайтиСтроки(сткОтбор).Количество() = 0 Тогда	
			пТекДанные.ЗначениеДанных = Результат;
			
			Модифицированность = Истина;
		Иначе
