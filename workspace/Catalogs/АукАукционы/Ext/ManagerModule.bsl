Функция ЗначенияНачальныхДанных(пАукцион, пВидАукциона = Неопределено, пУчастник = Неопределено) Экспорт
	
	Запрос = ЗначенияНачальныхДанных_Запрос(пАукцион, пВидАукциона, пУчастник);
	
	ПосленийПакет = АукОбщийСервер.СвойстваПоследнегоПакетаЗапроса(Запрос.Текст);
	
	масСтруктураНачДанных = Справочники.АукВидыАукционов.ОписаниеСтруктурыНачальныхДанныхПоВидуАукциона(пВидАукциона);
	
	тзРезультат = АукОбщийСервер.СоздатьТаблицуПоСоставуКолонок(ПосленийПакет.Колонки, "ЗначениеЭлементаДанных,ТехническоеНаименование", масСтруктураНачДанных);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	АукОбщийСервер.ЗаполнитьДанныеУчастниковПоРезультатуЗапроса(тзРезультат, РезультатЗапроса,
				ПосленийПакет.КонтрольныеТочкиИтогов.Количество(), "ТехническоеНаименование", "ЗначениеЭлементаДанных");
	
	Возврат тзРезультат;
	
КонецФункции

Функция ЗначенияНачальныхДанныхСГруппировками(пАукцион, пВидАукциона = Неопределено, пУчастник = Неопределено) Экспорт
		
	Запрос = ЗначенияНачальныхДанных_Запрос(пАукцион, пВидАукциона, пУчастник);
	
	Возврат Запрос.Выполнить();
	
КонецФункции

Функция ЗначенияНачальныхДанныхНезаписанногоОбъекта(пТзТабличнаяЧасть, пВидАукциона) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	тзТабличнаяЧасть.Участник КАК Участник,
	|	тзТабличнаяЧасть.СтрокаНачальныхДанных КАК СтрокаДанных,
	|	тзТабличнаяЧасть.ЭлементНачальныхДанных КАК ЭлементДанных,
	|	тзТабличнаяЧасть.ЗначениеНачальныхДанных КАК ЗначениеЭлементаДанных
	|ПОМЕСТИТЬ втТабличнаяЧасть
	|ИЗ
	|	&тзТабличнаяЧасть КАК тзТабличнаяЧасть
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	втТабличнаяЧасть.Участник КАК Участник,
	|	втТабличнаяЧасть.СтрокаДанных КАК СтрокаДанных,
	//|	втТабличнаяЧасть.ЭлементДанных КАК ЭлементДанных,
	|	втТабличнаяЧасть.ЗначениеЭлементаДанных КАК ЗначениеЭлементаДанных,
	|	АукЭлементыДанныхАукционов.ТехническоеНаименование КАК ТехническоеНаименование
	|ИЗ
	|	втТабличнаяЧасть КАК втТабличнаяЧасть
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ПланВидовХарактеристик.АукЭлементыДанныхАукционов КАК АукЭлементыДанныхАукционов
	|		ПО втТабличнаяЧасть.ЭлементДанных = АукЭлементыДанныхАукционов.Ссылка
	|ИТОГИ ПО
	|	Участник,
	|	СтрокаДанных";
	
	Запрос.УстановитьПараметр("тзТабличнаяЧасть", пТзТабличнаяЧасть);
	
	ПосленийПакет = АукОбщийСервер.СвойстваПоследнегоПакетаЗапроса(Запрос.Текст);
	
	масСтруктураНачДанных = Справочники.АукВидыАукционов.ОписаниеСтруктурыНачальныхДанныхПоВидуАукциона(пВидАукциона);
	
	тзРезультат = АукОбщийСервер.СоздатьТаблицуПоСоставуКолонок(ПосленийПакет.Колонки, "СтрокаДанных,ЗначениеЭлементаДанных,ТехническоеНаименование", масСтруктураНачДанных);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	АукОбщийСервер.ЗаполнитьДанныеУчастниковПоРезультатуЗапроса(тзРезультат, РезультатЗапроса,
				ПосленийПакет.КонтрольныеТочкиИтогов.Количество(), "ТехническоеНаименование", "ЗначениеЭлементаДанных");
	
	Возврат тзРезультат;
	
КонецФункции

