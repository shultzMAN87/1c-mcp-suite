Функция КлючевыеДанныеВидаАукциона(пВидАукциона) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	АукВидыАукционов.ВидОперации КАК ВидОперации,
	|	АукВидыАукционов.Продукт КАК Продукт,
	|	АукВидыАукционов.СРаспределениемСуммы КАК СРаспределениемСуммы,
	|	(ВЫРАЗИТЬ(АукВидыАукционов.ПромежуточныйИтогФормула КАК СТРОКА(50))) <> """"
	|		И (ВЫРАЗИТЬ(АукВидыАукционов.ПромежуточныйИтогШаблонРезультата КАК СТРОКА(50))) <> """" КАК ЕстьДанныеДляРасчетаПромежуточногоИтога,
	|	АукВидыАукционов.НастройкаРасчетаПромежуточныхИтогов КАК НастройкаРасчетаПромежуточныхИтогов,
	|	АукВидыАукционов.НастройкаРасчетаОкончательныхИтогов КАК НастройкаРасчетаОкончательныхИтогов
	|ИЗ
	|	Справочник.АукВидыАукционов КАК АукВидыАукционов
	|ГДЕ
	|	АукВидыАукционов.Ссылка = &ВидАукциона";
	
	Запрос.УстановитьПараметр("ВидАукциона", пВидАукциона);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если Не РезультатЗапроса.Пустой() Тогда
		Возврат ЭдоОбщийСервер.РезультатЗапросаВСтруктуру(РезультатЗапроса);
	Иначе
		сткРез = Новый Структура;
		
		сткРез.Вставить("ВидОперации", Неопределено);
		сткРез.Вставить("Продукт", Неопределено);
		сткРез.Вставить("НастройкаРасчетаПромежуточныхИтогов", Неопределено);
		сткРез.Вставить("НастройкаРасчетаОкончательныхИтогов", Неопределено);
		сткРез.Вставить("СРаспределениемСуммы", Ложь);
		сткРез.Вставить("ЕстьДанныеДляРасчетаПромежуточногоИтога", Ложь);
		
		Возврат сткРез;
	КонецЕсли;	
	
КонецФункции	

