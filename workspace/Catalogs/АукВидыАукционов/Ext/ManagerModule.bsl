Функция ОписаниеДанныхСвязанныхСАукциономПоВидуТолькоЗначения(пВидАукциона) Экспорт
	сооРезультат = Новый Соответствие;
	
	тзПараметрыАукциона = ОписаниеСтруктурыПараметровПоВидуАукциона(пВидАукциона, Истина);
		
	сооРезультат.Вставить(ПредопределенноеЗначение("Перечисление.АукИсточникиЗначенийПеременных.ПараметрАукциона"),
							АукОбщийКлиентСервер.КолонкаТаблицыВМассивСОтборомПоТипу(тзПараметрыАукциона, "Параметр", "ТипЗначения", Тип("Число")));
							
	тзСтруктураСтавки = ОписаниеСтруктурыСтавкиПоВидуАукциона(пВидАукциона, Истина);						
	
	сооРезультат.Вставить(ПредопределенноеЗначение("Перечисление.АукИсточникиЗначенийПеременных.Ставка"),
							АукОбщийКлиентСервер.КолонкаТаблицыВМассивСОтборомПоТипу(тзСтруктураСтавки, "Элемент", "ТипЗначения", Тип("Число")));
				
	тзНачальныеДанные = ОписаниеСтруктурыНачальныхДанныхПоВидуАукциона(пВидАукциона, Истина);						
							
	сооРезультат.Вставить(ПредопределенноеЗначение("Перечисление.АукИсточникиЗначенийПеременных.НачальныеДанные"),
							АукОбщийКлиентСервер.КолонкаТаблицыВМассивСОтборомПоТипу(тзНачальныеДанные, "Элемент", "ТипЗначения", Тип("Число")));
	
	Возврат сооРезультат;
КонецФункции	

