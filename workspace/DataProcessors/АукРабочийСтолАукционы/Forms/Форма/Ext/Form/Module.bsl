		сткПараметры.Вставить("НомерЭтапа",	ТекДанные.НомерЭтапа);
		
		Если АукОбщийКлиент.АукционПереведенНаПодведениеПромежуточныхИтогов(сткПараметры) Тогда
			
			ПеревестиАукционНаСледующийЭтап(ТекДанные);
	
