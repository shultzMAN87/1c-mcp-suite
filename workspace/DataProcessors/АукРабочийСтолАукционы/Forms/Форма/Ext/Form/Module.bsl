	Если Результат = Истина Тогда
		//пСткДанные.Вставить("НомерЭтапа", пТекДанные.НомерЭтапа);
		
		Если АукОбщийКлиент.ПромежуточныйИтогЗафиксирован(пТекДанные.Аукцион) Тогда
			
