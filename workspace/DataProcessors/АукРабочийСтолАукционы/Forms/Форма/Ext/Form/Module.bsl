			ПараметрыФормы.Вставить("Аукцион",		ТекДанные.Аукцион);
			ПараметрыФормы.Вставить("ВидАукциона",	ТекДанные.ВидАукциона);
			ПараметрыФормы.Вставить("НомерЭтапа",	ТекДанные.НомерЭтапа);
			
