#!/bin/bash
# =====================================================
# Запуск графической сессии внутри VNC
#
# TigerVNC вызывает этот скрипт в момент создания дисплея.
# Важно:
#   - НЕ использовать exec для fluxbox в самом конце, иначе сессия
#     завершится вместе с WM и VNC упадёт.
#   - Запускать терминал xterm сразу, чтобы у пользователя было
#     куда вводить команды (в VNC без панели задач иначе никак).
# =====================================================

# Убираем переменные, которые ломают старые VNC-клиенты
unset SESSION_MANAGER
unset DBUS_SESSION_BUS_ADDRESS

export XKL_XMODMAP_DISABLE=1
export LANG=ru_RU.UTF-8
export LC_ALL=ru_RU.UTF-8
export DISPLAY="${DISPLAY:-:0}"

# Если в системе есть /etc/X11/xinit/xinitrc-common, не тянем его —
# он может запустить xdg-user-dirs, gnome-session и прочее лишнее.

# 1. Стартуем терминал СРАЗУ — чтобы он успел привязаться к дисплею
#    до того, как появится fluxbox, и был виден сразу после подключения.
xterm -geometry 120x30+50+50 \
      -fa 'Monospace' -fs 11 \
      -bg black -fg white \
      -title '1C client terminal' &

# 2. Оконный менеджер fluxbox — в foreground как главный процесс сессии.
#    Пока fluxbox жив — VNC-сессия жива.
exec fluxbox
