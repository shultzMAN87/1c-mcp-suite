// Тестовый модуль YAxUnit для общего модуля Калькулятор.
// Структура:
//   ИсполняемыеСценарии() — обязательный entrypoint, регистрирует тесты в движке.
//   <Имя теста>()         — собственно тестовая процедура.

#Область ПрограммныйИнтерфейс

// Регистрация тестов в движке YAxUnit.
Процедура ИсполняемыеСценарии() Экспорт

    ЮТТесты
        .ДобавитьТест("Сложить_ДваПлюсДва_Возвращает4");

КонецПроцедуры

// Проверяет, что 2 + 2 = 4.
Процедура Сложить_ДваПлюсДва_Возвращает4() Экспорт

    // Arrange / Act
    Результат = Калькулятор.Сложить(2, 2);

    // Assert
    ЮТест.ОжидаетЧто(Результат, "Сложение 2+2")
        .Равно(4);

КонецПроцедуры

#КонецОбласти
